# ============================================================
# Nexora Environment Variables
# ------------------------------------------------------------
# Loaded automatically by Spring Boot via:
#   spring.config.import=optional:file:.env[.properties]
# IntelliJ's "EnvFile" plugin (validation.io compatible) reads
# this file too and injects vars into the run configuration.
# DO NOT use the dotenv-java library — values would be loaded
# twice and conflict with Spring's relaxed binding.
# ============================================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/nexora
DB_USERNAME=postgres
DB_PASSWORD=Ar0171##

# --- JWT ---
# Generate a real one with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-very-long-random-string-at-least-64-chars-abcdef0123456789
JWT_ACCESS_EXPIRY=3600000
JWT_REFRESH_EXPIRY=604800000

# --- Mail (SMTP) ---
# For Gmail use App Passwords: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Server ---
SERVER_PORT=8080

# --- Super Admin (seeded on first boot) ---
SUPER_ADMIN_EMAIL=admin@nexora.bd
SUPER_ADMIN_PASSWORD=Admin@12345